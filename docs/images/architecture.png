ignment\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"1638994742\":{\"name\":\"1638994742\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":19,\"id_type\":\"userID\",\"value\":{\"web_disabled_file_previewer_types\":[]},\"is_device_based\":false,\"passed\":false},\"2562735250\":{\"name\":\"2562735250\",\"rule_id\":\"1VxIWEnabUnUYnLrNXj42u:100.00:18-1VxIWCI7JCeqEYdwcPnqJs\",\"secondary_exposures\":[{\"gate\":\"3006008350\",\"gateValue\":\"true\",\"ruleID\":\"7qa92Sc3hwYJC1yMLU9mVq:100.00:3\"}],\"version\":138,\"id_type\":\"userID\",\"value\":{\"composer_enabled\":true,\"native_settings_enabled\":true,\"settings_enabled\":true,\"redirect_enabled\":true,\"skills_enabled\":true,\"nav_enabled\":true,\"native_plugins_v2\":true,\"enabled\":true},\"is_device_based\":false,\"passed\":true},\"1355628363\":{\"name\":\"1355628363\",\"rule_id\":\"6EkzgQkSDT4MxFNtb5sHlF:100.00:5-6EkzgOFQbAViegfxzXx42D\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"stableID\",\"value\":{\"prompts\":[{\"title\":\"Make a mango tasting mat\",\"body\":\"Create a bright text-light mango tasting mat with simple sections for aroma, sweetness, texture and favourite, leaving labels blank.\"},{\"title\":\"Create a music Reel backdrop\",\"body\":\"Create a text-light vertical backdrop for a music Reel. Use lively abstract shapes, no platform logos, and leave empty space for my caption.\"},{\"body\":\"Create a simple train ticket status flowchart with icons for CNF, RAC, WL and Tatkal. Keep labels short and editable.\",\"title\":\"Map train booking choices\"},{\"body\":\"Help me build a 20-minute reading routine. Ask me one question about when I can read, then suggest a first-week plan.\",\"title\":\"Build a reading routine\"},{\"title\":\"Learn to plan a short trip\",\"body\":\"Teach me how to plan a short trip from scratch. Ask one question about destination and dates, then build a simple itinerary outline.\"},{\"body\":\"Give me a fun Wimbledon 2026 primer: what makes grass-court tennis different, who to notice, and how to sound less lost.\",\"title\":\"Get into Wimbledon gently\"},{\"body\":\"Check the current Wimbledon schedule and suggest one match to follow from India, with the likely match time and one story to watch.\",\"title\":\"Pick a Wimbledon match\"},{\"body\":\"I need to send a tricky WhatsApp message. Ask me to paste it and say who it is for, then make it polite and natural.\",\"title\":\"Polish a WhatsApp message\"},{\"title\":\"Turn revision into a game\",\"body\":\"Make my unit-test revision feel like a game. Ask my subject first, then give a 20-minute plan with quick rounds.\"},{\"body\":\"Make a rainy-day commute game plan. Ask my city and route first, then suggest backup transport, timing buffers and what to pack.\",\"title\":\"Plan a rainproof commute\"},{\"title\":\"Make a cricket catch-up card\",\"body\":\"Give me a fun, no-jargon catch-up on the Women’s T20 World Cup, with India’s path, key players to notice, and one thing to watch today.\"},{\"title\":\"Plan a late-night cricket watch\",\"body\":\"Build a light India vs England watch plan for July: match reminders, snack breaks, and a simple way to follow if I miss overs.\"},{\"body\":\"Make a monthly kirana restock list. Ask my household size first, then organise staples, cleaning items and quick top-ups.\",\"title\":\"Build a kirana restock list\"},{\"title\":\"Read monsoon updates better\",\"body\":\"Explain today’s India monsoon update in plain English, including what normal, deficit and warning colours mean.\"},{\"title\":\"Build a monsoon travel buffer\",\"body\":\"Help me plan a monsoon journey with buffers for delays. Ask my city pair and travel mode, then make a practical backup plan.\"},{\"title\":\"Host a spoiler-free film chat\",\"body\":\"Make a spoiler-free debate guide for a current Indian film my friends have seen. Ask the film name, then give talking points.\"},{\"body\":\"Check the Wimbledon 2026 schedule and make me a simple IST viewing plan for the first week. Ask which players I care about.\",\"title\":\"Plan your Wimbledon viewing\"},{\"body\":\"Create a simple study quest map with 7 checkpoints, icons and blank labels. Ask me the subject first, then give label text separately.\",\"title\":\"Make a study quest map\"},{\"title\":\"Make a pantry check poster\",\"body\":\"Create a text-light pantry label-check poster with icons for MRP, expiry, ingredients, veg or non-veg symbol and storage.\"},{\"body\":\"Create a simple text-light rainy entryway layout for an Indian flat: shoe zone, umbrella spot, drying mat and hooks. No brand names.\",\"title\":\"Draw a rainy entryway\"},{\"title\":\"Get documents ready online\",\"body\":\"Help me prepare a DigiLocker-ready document set for admissions or a government service. Ask which task first.\"},{\"body\":\"Make a monsoon laundry rota for a small home where clothes dry indoors. Include smell prevention, rainy-day backup and what to wash first.\",\"title\":\"Fix monsoon laundry\"},{\"title\":\"Prepare Passport Seva papers\",\"body\":\"Help me prepare for a Passport Seva appointment. Check official document guidance and ask one question about my application type.\"},{\"title\":\"Set up DigiLocker basics\",\"body\":\"Explain DigiLocker in everyday terms and help me plan which documents to fetch, upload, or carry as originals.\"},{\"title\":\"Learn ride phrases\",\"body\":\"Teach me 8 polite phrases for an auto or cab ride. Ask my city or language first, then give pronunciation help.\"},{\"title\":\"Practise small talk lightly\",\"body\":\"Practise a 5-minute small-talk scene with me. Ask the setting first, then play the other person and keep it light.\"},{\"title\":\"Learn a topic with examples\",\"body\":\"Teach me a difficult topic using everyday examples. Ask me the topic first, then build a 10-minute lesson.\"},{\"body\":\"Plan 3 spill-proof tiffin ideas. Ask what I eat and whether I can reheat first, then keep it practical.\",\"title\":\"Pack a better tiffin\"},{\"body\":\"Make a first hostel packing list for India’s monsoon months. Ask my city and hostel rules first, then group must-haves and nice-to-haves.\",\"title\":\"Pack for hostel in the rains\"},{\"body\":\"Teach me how UPI AutoPay mandates work and give me a safe way to review subscriptions without sharing account details.\",\"title\":\"Review UPI AutoPay safely\"},{\"title\":\"Practise a meeting update\",\"body\":\"Practise a short meeting update with me. Give me a simple structure, then ask one question and correct my answer gently.\"},{\"body\":\"Create a text-light packing map for a monsoon hostel or PG room: bedding, documents, footwear, laundry and desk. Use simple icons.\",\"title\":\"Draw a hostel packing map\"},{\"title\":\"Rain-proof my day\",\"body\":\"Help me make a practical monsoon plan for today: commute, footwear, laundry and bag essentials. Ask for my city first.\"},{\"title\":\"Understand the new India names\",\"body\":\"Explain the young players people are discussing in India’s Ireland and England T20Is. Keep it beginner-friendly and avoid hype.\"},{\"body\":\"Write a clear, polite message to request a UPI split for a group expense. Keep it short and include a line asking people to verify payee name.\",\"title\":\"Share a UPI split politely\"},{\"body\":\"Make me a simple FIFA World Cup watch plan for India time. Ask which teams I follow, then suggest matches, snacks and a sleep-friendly routine.\",\"title\":\"Plan a World Cup night\"},{\"body\":\"Create a simple chore wheel with household task icons and blank name spaces. Ask how many people should fit on it first.\",\"title\":\"Create a chore wheel\"},{\"body\":\"Build a monsoon commute kit for my city and travel mode. Ask one question if needed, then group items as must-carry and optional.\",\"title\":\"Pack for monsoon commutes\"},{\"body\":\"Use current India music charts to build a 7-song playlist theme for a rainy commute. Avoid explicit lyrics unless I ask.\",\"title\":\"Build a rainy commute playlist\"},{\"title\":\"Create a match-night scoreboard\",\"body\":\"Create a text-light match-night scoreboard image for the Women’s T20 World Cup. Keep spaces blank for teams, runs, snacks, and MVP.\"},{\"title\":\"Build a smarter grocery run\",\"body\":\"Make a grocery list that prevents random extras. Ask what I’m cooking this week, then group items by store section.\"},{\"title\":\"Decode my train status\",\"body\":\"I’ll paste only my ticket status, not my full PNR. Explain CNF, RAC or WL and tell me the next sensible check.\"},{\"title\":\"Cook from fridge leftovers\",\"body\":\"Help me turn fridge leftovers into an Indian-style meal. I can upload a photo or list what I have.\"},{\"title\":\"Plan a short trip in India\",\"body\":\"Help plan a 2–3 day trip in India. First ask my starting city and rough budget, then suggest practical options.\"},{\"title\":\"Break down a charting song\",\"body\":\"Pick a song currently high on YouTube India and explain its hook, structure and replay value without quoting lyrics.\"},{\"title\":\"Learn cooker timing basics\",\"body\":\"Teach me pressure cooker basics for dal, rice and chana, including whistles, soaking and safety checks.\"},{\"body\":\"Create a 6-frame, text-light storyboard template for explaining why a current YouTube India song hook works, with no lyrics or artist likenesses.\",\"title\":\"Storyboard a song hook\"},{\"title\":\"Sort papers without panic\",\"body\":\"Give me a 30-minute game plan to sort household papers into keep, act and file piles. Ask what kind of papers I have first.\"},{\"title\":\"Pick a Van Mahotsav sapling\",\"body\":\"Help me pick one low-maintenance native sapling for Van Mahotsav. Ask my city and planting space, then give care steps.\"},{\"body\":\"Explain the FIFA World Cup knockout format for an India viewer, including how extra time and penalties work.\",\"title\":\"Learn the World Cup knockout\"},{\"body\":\"Create a text-light FIFA World Cup match-night tracker with blank team slots, score spaces, and room for IST timings.\",\"title\":\"Make a match-night tracker\"},{\"title\":\"Decode a talked-about squad pick\",\"body\":\"Give me a quick profile of a current India squad pick being searched a lot. Cover role, recent context and what to watch for.\"},{\"title\":\"Play mock interview ping-pong\",\"body\":\"Run a mock interview like ping-pong. Ask my role, then give one question at a time with a short coaching note after each answer.\"},{\"title\":\"Plan a tiffin rotation\",\"body\":\"Build a 5-day school or office tiffin rotation using Indian staples. Ask one question about dietary limits before suggesting.\"},{\"body\":\"Create a simple T20 fielding map for a new cricket fan using dots and zones, with any position names listed outside the image.\",\"title\":\"See field positions clearly\"},{\"body\":\"Explain Form 16, AIS, 26AS and ITR in simple terms for AY 2026-27. Ask one question only if you need my income type.\",\"title\":\"Understand Form 16 and AIS\"},{\"body\":\"Help me make a tiny-payment routine for chai, autos and kirana. Check current UPI Lite rules and remind me not to share PINs.\",\"title\":\"Sort tiny UPI payments\"},{\"title\":\"Decode holiday types\",\"body\":\"Explain gazetted, restricted and state holidays in India using the 2026 calendar. Give a simple rule for checking office or school closures.\"},{\"body\":\"Turn weekly chores into a fair, playful rota. Ask how many people are sharing, then suggest roles, swaps and a 10-minute reset.\",\"title\":\"Make chores less boring\"},{\"body\":\"Create a cosy, text-light image of an Indian monsoon snack board with chai, rain cues and blank label spaces.\",\"title\":\"Create a rainy-day snack board\"},{\"body\":\"Find three current India OTT trailers worth sampling tonight, then make a playful 30-minute no-spoiler watch plan.\",\"title\":\"Choose an OTT trailer night\"},{\"title\":\"Make a mini tennis bracket\",\"body\":\"Make a tiny Wimbledon bracket game I can use with friends, simple scoring, no expert knowledge needed.\"},{\"title\":\"Remix leftovers into dinner\",\"body\":\"Help me turn leftovers into dinner. Ask me for a fridge photo or ingredient list, then suggest 3 playful options with simple steps.\"},{\"title\":\"Make a tiffin idea wheel\",\"body\":\"Create a simple tiffin idea wheel with icons for grain, protein, veg, fruit and snack. Use blank labels, no brand names.\"},{\"title\":\"Discuss Kargil respectfully\",\"body\":\"Help me discuss Kargil Vijay Diwas in a balanced way for a study group. Give 5 questions that focus on history, courage and evidence.\"},{\"body\":\"Create a text-light Wimbledon bingo card image for a home watch. Use simple icons and blank squares, no player likenesses or logos.\",\"title\":\"Create a tennis bingo card\"},{\"body\":\"Create a simple layout sketch to make my desk or room easier to use. Ask for a photo or short description first.\",\"title\":\"Sketch a better room layout\"},{\"body\":\"Suggest a playful mango tasting at home for National Mango Day. Include ways to compare flavour, texture, aroma and use.\",\"title\":\"Host a mango tasting\"},{\"title\":\"Make a tennis score card\",\"body\":\"Create a clean, text-light tennis scorecard image for Wimbledon watching. Leave blanks for player names and sets. No logos.\"},{\"title\":\"Make a rainy commute card\",\"body\":\"Create a simple rainy-day commute safety card for India, using icons only and no location-specific claims.\"},{\"body\":\"Create a simple 6-panel image storyboard for a 20-second everyday Reel. Keep it text-light and use blank caption boxes.\",\"title\":\"Create a Reel storyboard\"},{\"body\":\"Help me reset my desk in 15 minutes. Ask me for a photo or short description, then turn it into 3 quick rounds.\",\"title\":\"Reset my desk like a game\"},{\"body\":\"Help me write a polite message to split a UPI payment. Ask what was paid and the amount, then make it clear without sounding awkward.\",\"title\":\"Settle a UPI split politely\"},{\"body\":\"Give me a friendly 5-minute guide to Puri Rath Yatra, including key words I’ll hear and respectful visitor basics.\",\"title\":\"Understand Rath Yatra quickly\"},{\"body\":\"Make a simple IST watch plan for the next FIFA World Cup 2026 matches I care about. Ask which teams I follow, then keep it realistic for workdays.\",\"title\":\"Plan a late-night World Cup watch\"},{\"title\":\"Design a drying corner\",\"body\":\"Create a text-light visual layout for a monsoon drying corner at home. Ask one question about space if needed.\"},{\"title\":\"Fix my match stream setup\",\"body\":\"Help me choose a reliable live-sport setup for home: TV, app or backup data. Ask what I’m watching and what devices I have.\"},{\"body\":\"Create a simple text-light illustration of Puri Rath Yatra’s temple-to-Gundicha journey, with blank labels I can fill in.\",\"title\":\"Create a Rath Yatra story map\"},{\"title\":\"Practise interview answers\",\"body\":\"Practise an interview for my role. Ask one question at a time, wait for my answer, then give brief feedback. First ask my role.\"},{\"body\":\"Help me write a short message to a driver, shop or technician in English and one Indian language I choose. Ask the language first.\",\"title\":\"Write a service message\"},{\"body\":\"Help me choose from current Hindi and pan-India theatrical releases. Ask my city and mood, then make a simple cinema plan.\",\"title\":\"Pick a cinema plan\"},{\"title\":\"Learn BGMI lag terms\",\"body\":\"Explain BGMI terms like ping, desync, FPS and server lag with simple examples a casual player would get.\"},{\"title\":\"Make a World Cup match tracker\",\"body\":\"Create a text-light World Cup match tracker image I can print. Use blank slots for teams, dates and predictions, with a clean football-night feel.\"},{\"title\":\"Check moon-sighting dates\",\"body\":\"Show me how moon-sighting based holidays can shift on calendars. Use Muharram 2026 as the example and give a simple planning rule.\"},{\"body\":\"Make a spoiler-light guide to India Women at the ICC Women’s T20 World Cup 2026. Include upcoming matches, storylines and terms to know.\",\"title\":\"Follow India Women with context\"},{\"body\":\"Create a text-light printable score card for a FIFA World Cup watch night, with blank spaces for teams, predictions, and snacks.\",\"title\":\"Create a match-night score card\"},{\"body\":\"Help me plan a safe Rath Yatra day in Puri. Ask my travel date and starting point, then make a realistic route and packing plan.\",\"title\":\"Plan a Rath Yatra day\"},{\"title\":\"Make an interview answer card\",\"body\":\"Create a simple visual card for structuring interview answers using four blank sections and small icons. Keep text minimal.\"},{\"title\":\"Plan a rain-safe commute\",\"body\":\"Help me plan a monsoon commute. Ask my city and usual route, then suggest what to check, carry and avoid today.\"},{\"title\":\"Plan a week of simple meals\",\"body\":\"Plan a week of simple meals. Ask one question about what I eat or have at home, then give meals and a shopping list for an Indian kitchen.\"},{\"title\":\"Make a weekly planner page\",\"body\":\"Create a clean weekly planner image with blank day blocks, priority space and simple symbols. Keep it mostly text-free.\"},{\"body\":\"Create a text-light weekly tiffin menu card with simple food icons and blank spaces I can fill in.\",\"title\":\"Make a tiffin menu card\"},{\"title\":\"Find a charting song angle\",\"body\":\"Use India’s current YouTube music charts to suggest one song-based Reel or Shorts idea. Keep it lyric-safe and easy to film.\"},{\"title\":\"Plan easy lunchbox ideas\",\"body\":\"Help me plan easy lunchbox ideas using what I usually buy. Ask my main staples, then keep it low-effort.\"},{\"title\":\"Make a water-check reminder\",\"body\":\"Create a text-light reminder card 